meta {
  name: List Users Default
  type: http
}

get {
  url: {{base_url}}/users
  body: none
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.eql(200);
  });
  test("Returns data array", function() {
    const body = res.getBody();
    expect(body.data).to.be.an('array');
  });
  test("Pagination defaults to limit 20 offset 0", function() {
    const p = res.getBody().pagination;
    expect(p.limit).to.eql(20);
    expect(p.offset).to.eql(0);
    expect(p.total).to.be.a('number');
  });
  test("Does not expose password_hash", function() {
    const body = res.getBody();
    for (const user of body.data) {
      expect(user.password_hash).to.eql(undefined);
    }
  });
  test("Rollback probe email is never present", function() {
    const body = res.getBody();
    const emails = body.data.map(function(user) { return user.email; });
    expect(emails).to.not.include("rollback-probe@example.com");
  });
}