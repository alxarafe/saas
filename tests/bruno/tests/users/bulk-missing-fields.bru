meta {
  name: Create Users Bulk Missing Fields
  type: http
}

post {
  url: {{base_url}}/users/bulk
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "data": [
      { "email": "missing-{{$randomUUID}}@example.com" }
    ]
  }
}

tests {
  test("Status is 422", function() {
    expect(res.getStatus()).to.eql(422);
  });
  test("Error code is validation_error", function() {
    expect(res.getBody().error.code).to.eql("validation_error");
  });
  test("Details point to missing field", function() {
    const details = res.getBody().error.details;
    expect(details).to.be.an('array');
    expect(details[0].field).to.eql("data[0].password_hash");
    expect(details[0].code).to.eql("required");
  });
}