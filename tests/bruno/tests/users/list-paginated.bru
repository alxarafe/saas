meta {
  name: List Users Paginated
  type: http
}

get {
  url: {{base_url}}/users?limit=1&offset=0
  body: none
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.eql(200);
  });
  test("Pagination reflects request params", function() {
    const p = res.getBody().pagination;
    expect(p.limit).to.eql(1);
    expect(p.offset).to.eql(0);
    expect(p.total).to.be.a('number');
  });
  test("Returns at most the requested limit", function() {
    const body = res.getBody();
    expect(body.data.length).to.be.lessThanOrEqual(1);
  });
}